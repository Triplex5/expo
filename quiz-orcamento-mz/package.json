{
  "name": "quiz-orcamento-mz",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz Orçamento MZ — jogo educativo gamificado sobre o Controlo da Execução Orçamental em Moçambique",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir web-build",
    "typecheck": "tsc --noEmit",
    "validate:bank": "node scripts/validate-bank.mjs",
    "smoke": "node scripts/smoke-logic.mjs",
    "check": "npm run typecheck && npm run validate:bank && npm run smoke"
  },
  "keywords": [
    "expo",
    "quiz",
    "orcamento",
    "mozambique",
    "sistafe",
    "gamificacao"
  ],
  "license": "MIT",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/react": "~19.2.0",
    "expo": "^57.0.27",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4",
    "typescript": "~5.9.2"
  }
}
